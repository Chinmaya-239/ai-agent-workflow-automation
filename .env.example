# Choose ONE provider (or none: the agent falls back to deterministic logic)
LLM_PROVIDER=auto            # auto | anthropic | openai | none
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional tuning
ROUTER_MIN_CONFIDENCE=0.35   # below this the agent asks which workflow you meant
LOG_RUNS=1                   # write every step to logs/runtime_logs.csv (WF010 analyses it)
